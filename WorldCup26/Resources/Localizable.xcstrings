    "settings.data.note": {
      "extractionState": "stale",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampprogram, hold og grupper fungerer offline. Liveresultater kræver forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielplan, Teams und Gruppen funktionieren offline. Live-Ergebnisse erfordern eine Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule, teams and groups work offline. Live scores require a connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario, los equipos y los grupos funcionan sin conexión. Los marcadores en directo requieren conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier, les équipes et les groupes fonctionnent hors ligne. Les scores en direct nécessitent une connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario, squadre e gironi funzionano offline. I risultati in diretta richiedono una connessione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampprogram, lag og grupper fungerer frakoblet. Liveresultater krever tilkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelschema, teams en groepen werken offline. Live-uitslagen vereisen een verbinding."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário, as seleções e os grupos funcionam offline. Os resultados em direto requerem ligação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelschema, lag och grupper fungerar offline. Liveresultat kräver anslutning."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розклад, команди та групи працюють офлайн. Для рахунків наживо потрібне з’єднання."
